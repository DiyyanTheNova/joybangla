############################################################
# .dockerignore — keep the build context small and free of
# local/dev/secret files. Everything here is regenerated or
# installed inside the image, so it never needs to be copied.
############################################################

# Dependencies (installed inside the image via `npm ci`)
node_modules/
.pnpm-store/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# Next.js build outputs (produced by `next build` inside the image)
.next/
out/
dist/
build/
.vercel/

# Tests & testing output
coverage/
.nyc_output/
__tests__/
__mocks__/
jest/
cypress/
playwright-report/
test-results/
*.test.*
*.spec.*

# Local dev / editor / OS junk
.git/
.gitignore
.gitattributes
.vscode/
.idea/
*.swp
*.swo
*~
*.log
.DS_Store
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
Desktop.ini

# Secrets & local env files.
# NOTE: `.env.production` is intentionally NOT ignored — supply non-secret
# build-time config there if you want. Real secrets must be passed at run
# time (docker run --env-file / compose `env_file`), never baked in.
.env
.env*.local
.env.development
.env.test
.env.production.local

# Docker files themselves (not needed in the build context)
Dockerfile*
.dockerignore
compose.yaml
compose.yml
docker-compose*.yaml
docker-compose*.yml

# Docs & CI
*.md
docs/
.github/
.gitlab-ci.yml
.travis.yml
.circleci/
Jenkinsfile

# Cache / temp dirs
.cache/
.parcel-cache/
.eslintcache
.stylelintcache
.swc/
.turbo/
.tmp/
.temp/

# TypeScript build metadata
*.tsbuildinfo

# Misc config not needed at build/runtime
*.pem
.editorconfig
.prettierrc*
prettier.config.*
.eslintrc*
.stylelintrc*
.babelrc*

# AI tool metadata
.cursor/
.cursorrules
.copilot/
.gemini/
.anthropic/
.claude
