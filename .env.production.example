# ============================================================
# Runtime environment template for the Docker image.
#
# Copy to `.env.production` and fill in real values:
#   cp .env.production.example .env.production
#
# `.env.production` is git-ignored. Pass it to the container with:
#   docker compose up -d --build      # reads .env.production automatically
#   docker run --env-file .env.production -p 3000:3000 joybangla:latest
#
# NOTE: NEXT_PUBLIC_* variables are INLINED at build time (they cannot be
# changed at run time). They are passed as Docker build args instead — see
# docker-compose.yml / the `docker build --build-arg ...` command. Set them in
# this file too if you run the app locally with `npm run build && npm start`.
# ============================================================

# --- Sanity CMS (public; also baked at build time) ---
NEXT_PUBLIC_SANITY_PROJECT_ID="8e5qmtmg"
NEXT_PUBLIC_SANITY_DATASET="production"
# Optional: server-side write token for drafts/preview (keep secret).
SANITY_API_TOKEN=""

# --- NextAuth ---
# Generate a strong secret, e.g.: openssl rand -base64 32
NEXTAUTH_SECRET="change-me-to-a-long-random-string"
# MUST match the public URL where the app is reachable (no trailing slash).
NEXTAUTH_URL="https://your-domain.com"

# --- Resend (transactional email for the contact form) ---
RESEND_API_KEY=""

# --- UploadThing (file uploads) ---
UPLOADTHING_SECRET=""
UPLOADTHING_APP_ID=""
